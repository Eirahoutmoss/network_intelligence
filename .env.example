# Copy to .env and fill in. Never commit .env.

# Database password (any strong random string)
POSTGRES_PASSWORD=change-me-db-password

# 32-byte key that encrypts stored SNMP/SSH credentials.
# Generate with:  openssl rand -base64 32
# Losing it makes stored credentials unreadable; keep a secure backup.
NEXUS_MASTER_KEY=

# Initial admin account (only used when no user exists yet).
# If empty, a random password is generated and printed once in the logs.
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=

# Set to 1 to start the built-in simulated campus network (demo/evaluation).
NEXUS_SIMULATOR=

# Set to true when serving over HTTPS (reverse proxy).
NEXUS_COOKIE_SECURE=false

# Optional: lets an LLM translate hard questions into search filters.
# Answers always come from the database; the LLM never sees device data.
ANTHROPIC_API_KEY=
