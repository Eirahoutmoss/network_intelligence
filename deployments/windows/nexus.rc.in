// No #include: constants are numeric so windres works with any C preprocessor.
// FILEOS 0x40004 = VOS_NT_WINDOWS32, FILETYPE 0x1 = VFT_APP

1 ICON "@ASSETS@/nexus.ico"
1 24 "@MANIFEST@"

1 VERSIONINFO
 FILEVERSION @VERSIONC@
 PRODUCTVERSION @VERSIONC@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Hasan Güler"
      VALUE "FileDescription", "@DESCRIPTION@"
      VALUE "FileVersion", "@VERSION@"
      VALUE "InternalName", "@NAME@"
      VALUE "LegalCopyright", "Copyright Hasan Güler. Apache License 2.0."
      VALUE "OriginalFilename", "@NAME@.exe"
      VALUE "ProductName", "Nexus Network Intelligence"
      VALUE "ProductVersion", "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
